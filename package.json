{
  "name": "nextjs-notion-starter-kit",
  "version": "2.0.0",
  "private": true,
  "description": "The perfect starter kit for building beautiful websites with Next.js and Notion.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": "transitive-bullshit/nextjs-notion-starter-kit",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "vercel deploy",
    "deps:update": "[ -z $GITHUB_ACTIONS ] && pnpm up -L notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:update on CI'",
    "deps:link": "[ -z $GITHUB_ACTIONS ] && run-s deps:link:* || echo 'Skipping deps:update on CI'",
    "deps:unlink": "[ -z $GITHUB_ACTIONS ] && pnpm unlink notion-client notion-types notion-utils react-notion-x || echo 'Skipping deps:unlink on CI'",
    "deps:link:notion-types": "pnpm link ../react-notion-x/packages/notion-types",
    "deps:link:notion-utils": "pnpm link ../react-notion-x/packages/notion-utils",
    "deps:link:notion-client": "pnpm link ../react-notion-x/packages/notion-client",
    "deps:link:react-notion-x": "pnpm link ../react-notion-x/packages/react-notion-x",
    "test": "run-p test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:typecheck": "tsc --noEmit",
    "fix": "run-s fix:*",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix"
  },
  "dependencies": {
    "@keyvhq/core": "^2.2.7",
    "@keyvhq/redis": "^2.2.7",
    "classnames": "^2.5.1",
    "expiry-map": "^2.0.0",
    "fathom-client": "^3.7.2",
    "katex": "^0.18.4",
    "ky": "^2.0.2",
    "lqip-modern": "^3.0.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "notion-client": "^8.0.2",
    "notion-types": "^8.0.2",
    "notion-utils": "^8.0.2",
    "p-map": "^7.0.6",
    "p-memoize": "^8.0.0",
    "posthog-js-lite": "^4.10.3",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-body-classname": "^1.3.1",
    "react-dom": "^19.2.8",
    "react-notion-x": "^8.0.2",
    "react-tweet": "^3.3.1",
    "react-use": "^17.6.1",
    "rss": "^1.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@fisch0920/config": "^2.0.5",
    "@types/node": "^26.2.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-body-classname": "^1.1.10",
    "@types/rss": "^0.0.32",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0"
}
