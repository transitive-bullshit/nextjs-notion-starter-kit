# ------------------------------------------------------------------------------
# This is an example .env file.
#
# All of these environment vars must be defined either in your environment or in
# a local .env file in order to run this app.
#
# @see https://github.com/rolodato/dotenv-safe for more details.
# ------------------------------------------------------------------------------

# Optional (enables /owner; 8 characters minimum, random value recommended)
# Generate one with: openssl rand -base64 32
#OWNER_MODE_SECRET=

# Optional (for rendering tweets more efficiently)
#TWITTER_ACCESS_TOKEN=

# Optional (for persisting preview images to redis)
# NOTE: if you want to enable redis, only REDIS_HOST and REDIS_PASSWORD are required
# NOTE: don't forget to set isRedisEnabled to true in the site.config.ts file
#REDIS_HOST=
#REDIS_PASSWORD=
#REDIS_USER='default'
#REDIS_NAMESPACE='preview-images'
# Or provide a full connection URL instead of the parts above (must be a valid URL):
#REDIS_URL=

# Optional (override the Notion API base URL; must be a valid URL)
#NOTION_API_BASE_URL=

# Optional (only if 403s on Notion's loadPageChunk persist after the
# built-in User-Agent fix in lib/notion-api.ts). Log into notion.so, open
# DevTools -> Application -> Cookies -> www.notion.so, copy "token_v2".
#NOTION_TOKEN_V2=

# Optional, pairs with NOTION_TOKEN_V2. The "notion_user_id" cookie value
# from the same DevTools panel.
#NOTION_ACTIVE_USER=

# Optional (dev server port; must be a positive integer, defaults to 3000)
#PORT=3000
